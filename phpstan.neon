# phpstan.neon
parameters:
    bootstrapFiles:
        - phpstan-bootstrap.php
    level: 1
    paths:
        - conlite
        - conlib
        - setup
    excludePaths:
        - conlite/plugins/pluginmanager/docs/pear/*
    ignoreErrors:
        -
            identifiers:
                - property.notFound
                - property.neverWritten
                - method.notFound
                - variable.undefined

